# Text files are stored and checked out with LF on every platform (Windows clones included): the
# generated JSON is compared byte for byte by `hsl check`, and GDScript／shell／Python do not care.
* text=auto eol=lf

# Binary media and packs: never converted, never diffed as text (extensions in both cases where the
# original resources use upper case).
*.png binary
*.PNG binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.bmp binary
*.ico binary
*.wav binary
*.WAV binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.ttf binary
*.otf binary
*.pak binary
*.exe binary
*.dll binary
*.zip binary
*.gz binary
*.sav binary
*.SAV binary
*.bin binary
*.res binary
*.scn binary

# Byte-exact extracted source inputs, not authored project text. Preserve native
