  "term_format": "A stat is the integer sum of its terms. A term [mul, var, div] is mul*var/div, [mul, var, div, pre] is mul*(var/pre)/div (every division is integer division, evaluated left to right as written), a bare integer is a constant. Variables: str dex mind con level hp_level (hp_level is level when the source mode has bit 0x10000, else 0).",
  "stat_format": {
    "magic_attack": "sum(terms); then min(cap) when cap is set; then (value-soft_knee)/2+soft_knee when soft_knee is set and value > soft_knee; then + bonus",
    "resist": "five rows in element order earth water air fire mind; each is min(cap, p*mind/100 + con/div) for a row [p, div]",
    "caps": "four base-attribute caps in str dex mind con order (native cap table 0x4786bc)",
    "allocation_quota": "automatic five-point allocation quota per str dex mind con (native quota dispatch 0x43a128)"
  },
